# Build output.
/target/
**/target/
/.prism/

# LexLean build output and the Lean workspace's package cache.
/.lexlean/
/.lake/

# The scaling harness writes its fits here; the committed artifact is the
# report in `oracles/`, not the raw run.
/reports/
criterion/

# cargo-fuzz working state. The corpus that matters is committed under
# `fuzz/corpus/`; the rest is machine-local.
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Editor and OS noise.
.DS_Store
*.swp
*~
.idea/
.vscode/

# `Cargo.lock` is NOT ignored: the resolved version of every oracle is part of
# the claim made against it (R11).

# The conformance build: what `prismpm build` generates and `conformance/lay-out.sh`
# copies beside the binding (the consumer workspace, conformance/Cargo.toml).
/conformance/mcp_conformance_core/
/conformance/mcp-conformance-host-api/
/conformance/mcp-conformance-host/
/conformance/target/
